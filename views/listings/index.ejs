<% layout("listings/layouts/boilerplate") %>

<style>
    #filters{
    display:flex;
    align-items:center;
    gap:1rem;
    margin:1.5rem 0;
}

.filter-container{
    display:flex;
    align-items:center;
    gap:1.4rem;

    flex:1;
    overflow-x:auto;
    scroll-behavior:smooth;

    scrollbar-width:none;
    -ms-overflow-style:none;
}

.filter-container::-webkit-scrollbar{
    display:none;
}

.filter{
    text-align:center;
    opacity:.7;
    min-width:75px;
    flex-shrink:0;
}

.filter:hover{
    opacity:1;
    cursor:pointer;
}

.filter p{
    margin-bottom:0;
    font-size:.82rem;
}

.tax-toggle{
    white-space:nowrap;
    display:flex;
    align-items:center;
    margin-left:.5rem;
}

.tax-toggle .form-check{
    display:flex;
    align-items:center;
    gap:.5rem;
    margin:0;
}

.scroll-btn{
    width:36px;
    height:36px;
    border:1px solid #ddd;
    border-radius:50%;
    background:white;

    display:flex;
    justify-content:center;
    align-items:center;

    cursor:pointer;
    transition:.2s;
}

.scroll-btn:hover{
    background:#f5f5f5;
}

.scroll-btn i{
    font-size:12px;
}

.tax-info{
    display:none;
}

.filter{
    text-decoration: none;
    color: inherit;

    text-align:center;
    opacity:.7;
    min-width:75px;
    flex-shrink:0;
}

.filter:visited{
    color:inherit;
}

.filter:hover{
    color:inherit;
    opacity:1;
    cursor:pointer;
}

</style>

<div id="filters">

     <button class="scroll-btn left-btn">
        <i class="fa-solid fa-chevron-left"></i>
    </button>

     <div class="filter-container">

    <a href="/listings?category=Trending" class="filter">
       <div><i class="fa-solid fa-fire"></i></div>
        <p>Trending</p>
    </a>

    <a href="/listings?category=Rooms" class="filter">
       <div><i class="fa-solid fa-bed"></i></div>
        <p>Rooms</p>
    </a>
    <a href="/listings?category=Iconic Cities" class="filter">
       <div><i class="fa-solid fa-mountain-city"></i></div>
        <p>Iconic Cities</p>
    </a>
    <a href="/listings?category=Mountains" class="filter">
       <div><i class="fa-solid fa-mountain"></i></div>
        <p>Mountains</p>
    </a>
    <a href="/listings?category=Castles" class="filter">
       <div><i class="fa-brands fa-fort-awesome"></i></div>
        <p>Castles</p>
    </a>
    <a href="/listings?category=Amazing Pools" class="filter">
       <div><i class="fa-solid fa-person-swimming"></i></div>
        <p>Amazing Pools</p>
    </a>
    <a href="/listings?category=Camping" class="filter">
       <div><i class="fa-solid fa-campground"></i></div>
        <p>Camping</p>
    </a>
    <a href="/listings?category=Farms" class="filter">
       <div><i class="fa-solid fa-cow"></i></div>
        <p>Farms</p>
    </a>
    <a href="/listings?category=Arctic" class="filter">
       <div><i class="fa-regular fa-snowflake"></i></div>
        <p>Arctic</p>
    </a>
    <a href="/listings?category=Domes" class="filter">
       <div><i class="fa-solid fa-igloo"></i></div>
        <p>Domes</p>
    </a>
    <a href="/listings?category=Boats" class="filter">
       <div><i class="fa-solid fa-ship"></i></div>
        <p>Boats</p>
    </a>
    </div>

    <button class="scroll-btn right-btn">
        <i class="fa-solid fa-chevron-right"></i>
    </button>

    <div class="tax-toggle">
        <div class="form-check form-switch">
            <input class="form-check-input" type="checkbox" role="switch" id="flexSwitchCheckDefault">
            <label class="form-check-label" for="flexSwitchCheckDefault">Display total after taxes</label>
        </div>
    </div>

</div>
<div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 mt-3">
    <% for(let listing of allListings) { %>
        <a href="/listings/<%= listing._id %>" class="listing-link">
    <div class="card col listing-card">
       <img src="<%= listing.image.url%>" class="card-img-top" alt="Listing_image" style="height: 20rem">
       <div class="card-img-overlay"></div>
       <div class="card-body">
        <p class="card-text">
            <b><%= listing.title %> <br /></b>
            &#8377; <%= listing.price.toLocaleString("en-IN") %> / night
            <i class="tax-info"> &nbsp; &nbsp;+18% GST</i>
        </p>
       </div>
    </div>
    
   </a>
    <% } %>
</div> 


<script>
    let taxSwitch = document.getElementById("flexSwitchCheckDefault");
    taxSwitch.addEventListener("click", () => {
        let taxInfo = document.getElementsByClassName("tax-info");
        for(info of taxInfo){
            if(info.style.display != "inline"){
                info.style.display = "inline";
            }else{
                info.style.display = "none";
            }
        }
    });

     const filterContainer = document.querySelector(".filter-container");
    const leftBtn = document.querySelector(".left-btn");
    const rightBtn = document.querySelector(".right-btn");

    function updateButtons() {

        leftBtn.style.visibility =
            filterContainer.scrollLeft <= 5
            ? "hidden"
            : "visible";

        rightBtn.style.visibility =
            filterContainer.scrollLeft >=
            filterContainer.scrollWidth -
            filterContainer.clientWidth - 5
            ? "hidden"
            : "visible";
    }

    leftBtn.addEventListener("click", () => {
        filterContainer.scrollBy({
            left: -250,
            behavior: "smooth"
        });
    });

    rightBtn.addEventListener("click", () => {
        filterContainer.scrollBy({
            left: 250,
            behavior: "smooth"
        });
    });

    filterContainer.addEventListener("scroll", updateButtons);

    window.addEventListener("load", updateButtons);

</script>
